<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude FlutterSecureStorage shared preferences to avoid InvalidKeyException on restore -->
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
        <!-- Native credentials use app sync; WebView sessions stay device-local. -->
        <exclude domain="file" path="openlist/"/>
        <exclude domain="root" path="app_webview/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
        <!-- Native credentials use app sync; WebView sessions stay device-local. -->
        <exclude domain="file" path="openlist/"/>
        <exclude domain="root" path="app_webview/"/>
    </device-transfer>
</data-extraction-rules>
