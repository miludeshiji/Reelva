<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude FlutterSecureStorage shared preferences to avoid InvalidKeyException on restore -->
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
    <!-- Keep ordinary library database backup, but never copy native credentials. -->
    <exclude domain="file" path="openlist/"/>
    <exclude domain="file" path="logs/"/>
    <exclude domain="root" path="app_webview/"/>
</full-backup-content>
